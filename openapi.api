openapi: "3.0.0"

info:
  title: test xss / html-injection
  version: "1.0.0"
  description: |
    <!-- HTML Injection probe: should render as styled box below if vulnerable -->
    <div id="inject-probe" style="padding:12px;border:2px dashed; margin:8px 0;">
      <h4>HTML Injection Probe</h4>
      <p>لو شايف البوكس ده متنسّق وبجواه عناصر HTML، يبقى الـ UI بيرندر HTML من description.</p>
    </div>

    <style>
      /* تأثير بصري واضح وآمن */
      #inject-probe { font-weight: bold; }
      /* لو الـ UI بيسمح بـ <style> هتشوف العنوان ده بيتلوّن */
      .rendered-markdown h1, .markdown h1 { text-decoration: underline; }
    </style>

    <!-- اختبارات سمات HTML غير تنفيذية -->
    <a href="#probe" title="title-attr-visible">Anchor with title attribute</a>

    <!-- ملاحظات:
         - ده اختبار HTML “آمن” بلا JavaScript.
         - لو ظهر الـ <style> وتأثيره واضح، يبقى فيه HTML/CSS injection.
         - لو اتعرضت الوسوم نصاً (بدون تأثير بصري)، فالواجهة غالباً بتعمل sanitize أو escape. -->

paths:
  /ping:
    get:
      summary: Ping
      responses:
        '200':
          description: OK
